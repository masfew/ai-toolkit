<Window x:Class="UAssetLens.App.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UAssetLens.App"
        Style="{StaticResource LensWindow}" WindowStartupLocation="CenterScreen" Width="940" Height="640" MinWidth="560" MinHeight="320">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:GroupItem}">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Row}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontSize="11" Padding="14,9,14,5"/>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DiffItem}">
            <Border BorderBrush="{StaticResource Row}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding DataContext.LabelWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <ColumnDefinition Width="{Binding DataContext.BeforeWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <ColumnDefinition Width="{Binding DataContext.AfterWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CellText}" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CellText}" Text="{Binding Before.Text}" Foreground="{Binding Before.Foreground}"
                               Background="{Binding Before.Background}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource CellText}" Text="{Binding After.Text}" Foreground="{Binding After.Foreground}"
                               Background="{Binding After.Background}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,12,14,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
                <WrapPanel>
                    <TextBlock x:Name="NameText" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="TypeChip" Background="{StaticResource Row}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TypeText" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="14,7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource LensButton}" Content="Copy summary" Click="Copy_Click"/>
                <CheckBox x:Name="ShowUnchanged" DockPanel.Dock="Right" Style="{StaticResource LensToggle}" Content="Show unchanged"
                          Checked="ShowUnchanged_Changed" Unchecked="ShowUnchanged_Changed"/>
                <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource PinToggle}"
                              ToolTip="Keep this window as it is. The next diff opens in a new window."/>
                <TextBlock x:Name="ChangedText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border x:Name="ProblemBox" DockPanel.Dock="Top" Margin="14,10,14,0" Padding="10,8" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Orange}" BorderThickness="3,0,0,0" CornerRadius="0,4,4,0" Visibility="Collapsed">
            <TextBlock x:Name="ProblemText" TextWrapping="Wrap"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="14,9" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LensButton}" Content="Close" IsCancel="True" Click="Close_Click"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PathText" Style="{StaticResource Meta}" Margin="0"/>
                    <TextBlock x:Name="VersionsText" Style="{StaticResource Meta}"/>
                    <TextBlock x:Name="FooterText" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,6,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LabelWidth}"/>
                    <ColumnDefinition Width="{Binding BeforeWidth}"/>
                    <ColumnDefinition Width="{Binding AfterWidth}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColumnHead}" Text="Setting"/>
                <TextBlock x:Name="BeforeHead" Grid.Column="1" Style="{StaticResource ColumnHead}" Text="Before"/>
                <TextBlock x:Name="AfterHead" Grid.Column="2" Style="{StaticResource ColumnHead}" Text="After"/>
            </Grid>
        </Border>

        <Grid>
            <ItemsControl x:Name="RowsList" Style="{StaticResource RowList}"/>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
